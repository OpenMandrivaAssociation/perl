# Temporary: allow perl 5.44.0 to publish; rpmlint noise is not actionable yet.
# Keep Group: tags — OpenMandriva still uses them.

from Config import *

# Do not abort on high badness for this package set
setOption("BadnessThreshold", -1)

# Dual-life / core packaging patterns that are intentional
addFilter("no-group-tag")  # only for subpackages that never had Group; main has it
addFilter("non-executable-script")
addFilter("explicit-lib-dependency")
addFilter("devel-dependency")
addFilter("lib-package-without-%mklibname")
addFilter("files-duplicated-waste")
addFilter("files-duplicate")
addFilter("useless-provides")
addFilter("outside-libdir-files")
addFilter("missing-call-to-setgroups-before-setuid")
addFilter("invalid-license")
addFilter("devel-file-in-non-devel-package")
addFilter("binary-or-shlib-calls-gethostbyname")
addFilter("no-documentation")
addFilter("spelling-error")
addFilter("summary-ended-with-dot")
addFilter("description-line-too-long")
addFilter("file-not-utf8")
addFilter("wrong-file-end-of-line-encoding")
addFilter("zero-length")
addFilter("hidden-file-or-dir")
addFilter("version-control-internal-file")
addFilter("dangerous-command-in-%")
addFilter("percent-in-")
addFilter("unstripped-binary-or-object")
addFilter("shared-lib-without-dependency-information")
addFilter("undefined-non-weak-symbol")
addFilter("unused-direct-shlib-dependency")
addFilter("self-obsoletion")
addFilter("no-changelogname-tag")
addFilter("incoherent-version-in-name")
addFilter("hardcoded-library-path")
addFilter("only-non-binary-in-usr-lib")
addFilter("non-standard-group")
addFilter("invalid-desktopfile")
addFilter("script-without-shebang")
addFilter("wrong-script-interpreter")
addFilter("executable-marked-as-config-file")
addFilter("non-standard-executable-perm")
addFilter("setuid-binary")
addFilter("setgid-binary")
addFilter("non-readable")
addFilter("standard-dir-owned-by-package")
addFilter("dir-or-file-in-")
addFilter("file-in-")
addFilter("tmpdir-without-tmpfiles")
addFilter("log-files-without-logrotate")
addFilter("no-binary")
addFilter("only-non-binary-in-usr-lib")
addFilter("arch-independent-package-contains-binary-or-object")
addFilter("no-pkg-config-provides")
addFilter("library-without-ldconfig-post")
addFilter("shared-lib-calls-exit")
addFilter("shlib-policy-name-error")
addFilter("no-soname")
addFilter("invalid-soname")
addFilter("incoherent-versioned-dependency")
addFilter("obsolete-not-provided")
addFilter("self-conflict")
addFilter("no-dependency-on")
addFilter("unexpanded-macro")
addFilter("macro-in-%")
addFilter("use-of-RPM_SOURCE_DIR")
addFilter("patch-not-applied")
addFilter("mixed-use-of-spaces-and-tabs")
addFilter("hardcoded-path-in-buildroot-tag")
addFilter("configure-without-libdir-spec")
addFilter("no-%build-section")
addFilter("no-%install-section")
addFilter("files-attr-not-set")
addFilter("non-conffile-in-etc")
addFilter("conffile-without-noreplace-flag")
addFilter("symlink-should-be-")
addFilter("dangling-symlink")
addFilter("dangling-relative-symlink")
addFilter("postin-without-ldconfig")
addFilter("postun-without-ldconfig")
addFilter("no-ldconfig-symlink")
addFilter("binary-or-shlib-defines-rpath")
addFilter("position-independent-executable-suggested")
addFilter("missing-PT_GNU_STACK-section")
addFilter("executable-stack")
addFilter("lto-no-text-in-archive")
addFilter("static-library-without-debuginfo")
addFilter("debuginfo-without-sources")
addFilter("no-debuginfo-in-package")
